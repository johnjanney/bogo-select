# Build artefacts — versioned plugin zips are kept on disk, not in git.
# See BRIEF.md §8.3: previous zips are never deleted.
/dist/

# Development dependencies — the shipped plugin has none. composer.lock is
# tracked so CI resolves the same versions the suite was written against.
/vendor/
.phpunit.result.cache

# Local analyser overrides. The .dist files are tracked; these are the
# per-developer copies PHPStan and PHPCS prefer when they exist.
/phpstan.neon
/.phpcs.xml
/.phpcs.cache

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Integration-test scratch. package.json and package-lock.json are tracked, so
# the browser the job installs is the one the lockfile pins; node_modules and
# the per-run screenshots are not.
/node_modules/
/tests/integration/node_modules/
/tests/integration/package.json
/tests/integration/package-lock.json
integration-*.png
