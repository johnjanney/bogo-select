includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    # Raised in steps rather than set at maximum on day one, and with no
    # baseline at any step: the level is only allowed to say something true
    # about the code, so it stays where the code actually passes.
    #
    # 5 checks argument types against the WordPress and WooCommerce stubs. 6
    # additionally requires every `array` in a docblock to say what it holds and
    # every method to declare a return type. 7 checks that a union is narrowed
    # before it is used, which is where wc_get_product() returning
    # `WC_Product|false` stopped being invisible.
    #
    # 8 checks what happens to a null, which is how three functions came to fold
    # wc_get_product()'s two ways of saying "no product" into one.
    #
    # 9 makes `mixed` explicit. It was abandoned once at 40 remaining findings,
    # on two conclusions that were both wrong, and the record is kept here
    # because the way they were wrong is the useful part.
    #
    # The first was that threading the settings shape through the admin
    # sanitizer made things worse — the count went from 41 to 80. It did not.
    # The `@phpstan-import-type` line had never reached the file, so the type
    # name resolved to nothing and every read of it became "access to an offset
    # on an unknown class". With the import present, the same change removes 21
    # findings.
    #
    # The second was that the cart-item casts needed eighteen unreachable
    # is_scalar() branches. Most wanted a shape declared instead — state() and
    # variation_options() both build known arrays and now say so — and the
    # genuine cart-line reads go through the same to_id() helper as any other
    # untrusted value, which is shorter than the cast it replaced.
    #
    # The lesson is not about PHPStan. A tool reporting more errors after a
    # change is evidence about the change, and it was read as a verdict on it.
    level: 9

    # The plugin still supports 7.4, so the analyser must judge it as 7.4 even
    # when it runs on a newer PHP in CI.
    phpVersion: 70400

    paths:
        - bogo-select.php
        - uninstall.php
        - includes

    # Runtime code only. The unit suite runs against hand-written WordPress and
    # WooCommerce stubs of its own, which declare the same functions as the stub
    # packages below; analysing both together reports every one of them as a
    # redeclaration and says nothing about either.
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php

    # Under bin/ because both bin/build-zip.sh and bin/verify-zip.sh already
    # prune that directory. A .php file at the repository root would have to be
    # named in an exclude list in each of them, and forgetting one either ships
    # analyser scaffolding to stores or breaks package verification.
    bootstrapFiles:
        - bin/phpstan-constants.php

    # The stubs describe the WooCommerce and WordPress of today, and describe it
    # optimistically: a docblock saying a filter returns an array does not stop
    # a third party returning null, and a method the stubs declare may not exist
    # in the oldest WooCommerce this plugin supports. Guards written for those
    # cases are not dead code, and analysing docblock types as certainties would
    # report every one of them as redundant and invite their removal. Native
    # types are still treated as certain, because those the engine enforces.
    treatPhpDocTypesAsCertain: false
